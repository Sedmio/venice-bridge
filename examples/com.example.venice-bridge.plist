<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replace /PATH/TO with real absolute paths, copy to ~/Library/LaunchAgents/, then:
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.venice-bridge.plist -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.venice-bridge</string>
  <key>ProgramArguments</key><array>
    <string>/PATH/TO/python3</string>
    <string>-u</string>
    <string>/PATH/TO/venice-bridge/venice_bridge.py</string>
  </array>
  <key>WorkingDirectory</key><string>/PATH/TO/venice-bridge</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>/PATH/TO/venice-bridge/venice_bridge.log</string>
  <key>StandardErrorPath</key><string>/PATH/TO/venice-bridge/venice_bridge.log</string>
</dict></plist>
